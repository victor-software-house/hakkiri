#!/bin/sh
# The C compiler cc-rs uses for the x86_64-unknown-linux-musl release build.
# zig names the target x86_64-linux-musl, and cc-rs adds the Rust triple
# --target=x86_64-unknown-linux-musl, which zig cannot parse, so that one
# argument is dropped.
set -eu
count=$#
while [ "$count" -gt 0 ]; do
  arg=$1
  shift
  count=$((count - 1))
  case "$arg" in
    --target=*) ;;
    *) set -- "$@" "$arg" ;;
  esac
done
exec zig cc -target x86_64-linux-musl "$@"
