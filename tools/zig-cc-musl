#!/bin/sh
# The C compiler cc-rs uses for the musl release builds, x86_64 and aarch64.
# cc-rs adds the Rust triple as --target=<arch>-unknown-linux-musl, which zig
# cannot parse. This script drops that argument and gives zig the same target
# in its own spelling, <arch>-linux-musl.
set -eu
triple=
count=$#
while [ "$count" -gt 0 ]; do
  arg=$1
  shift
  count=$((count - 1))
  case "$arg" in
    --target=*) triple=${arg#--target=} ;;
    *) set -- "$@" "$arg" ;;
  esac
done
: "${triple:?cc-rs passed no --target}"
exec zig cc -target "${triple%%-*}-${triple#*-*-}" "$@"
